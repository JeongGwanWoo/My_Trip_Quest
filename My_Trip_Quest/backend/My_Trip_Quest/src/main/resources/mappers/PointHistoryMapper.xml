<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mytripquest.domain.pointhistory.repository.PointHistoryMapper">

    <select id="findByUserId" resultType="com.mytripquest.domain.pointhistory.PointHistory">
        SELECT
            id,
            user_id as userId,
            description,
            amount,
            balance,
            created_at as createdAt
        FROM point_history
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

</mapper>
